# Firebase コンソール > プロジェクトの設定 > マイアプリ (ウェブ) の値を設定する。
# 未設定の場合はブラウザ内保存のローカルモードで動作する。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (Firebase AI Logic に必須)。https://www.google.com/recaptcha/admin で作った reCAPTCHA v3 のサイトキー
# (シークレットは Firebase コンソール > App Check の reCAPTCHA 設定に登録する。ここには書かない)
VITE_RECAPTCHA_SITE_KEY=
# 開発用 (localhost)。コンソール > App Check > デバッグトークンの管理 に登録した UUID
VITE_APPCHECK_DEBUG_TOKEN=
