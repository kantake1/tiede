rules_version = '2';

// 旅行IDを知っている人は誰でも閲覧・編集できる。
// 旅行一覧の取得(list)は禁止し、IDの総当たり以外で他人の旅行に到達できないようにする。
service cloud.firestore {
  match /databases/{database}/documents {
    function tripExists(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId));
    }

    function validName(s, max) {
      return s is string && s.size() > 0 && s.size() <= max;
    }

    match /trips/{tripId} {
      allow get: if true;
      allow list, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && validName(request.resource.data.name, 100)
        && request.resource.data.createdAt == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name, 100);

      match /members/{memberId} {
        allow read, delete: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && validName(request.resource.data.name, 50)
          && (tripExists(tripId) || existsAfter(/databases/$(database)/documents/trips/$(tripId)));
        // removedAt: 論理削除の印 (#42 の移行期間。旧版の削除 (delete) もまだ許す)
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'removedAt'])
          && validName(request.resource.data.name, 50)
          && (!('removedAt' in request.resource.data) || request.resource.data.removedAt is timestamp);
      }

      match /categories/{categoryId} {
        allow read, delete: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && validName(request.resource.data.name, 50)
          && tripExists(tripId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'archived', 'removedAt'])
          && validName(request.resource.data.name, 50)
          && (!('removedAt' in request.resource.data) || request.resource.data.removedAt is timestamp)
          && (!('archived' in request.resource.data) || request.resource.data.archived is bool);
      }

      // レシート写真 (支払いと同じ ID)。JPEG の base64 で約300KB (文字数 41万) まで
      match /receipts/{expenseId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 420000
          && (tripExists(tripId) || existsAfter(/databases/$(database)/documents/trips/$(tripId)));
      }

      match /expenses/{expenseId} {
        function validExpense(d) {
          return d.keys().hasOnly(['title', 'amount', 'payerId', 'mode', 'shares', 'items', 'categoryId', 'memo', 'date', 'hasReceipt', 'settledIds', 'deletedAt', 'trashedAt', 'createdAt'])
            && validName(d.title, 100)
            && d.amount is int && d.amount > 0 && d.amount <= 10000000000
            && d.payerId is string && d.payerId.size() > 0 && d.payerId.size() <= 64
            && d.mode in ['equal', 'ratio', 'amount', 'items']
            && d.shares is map && d.shares.size() <= 100
            && (!('items' in d) || (d.items is list && d.items.size() <= 200))
            && (!('categoryId' in d) || (d.categoryId is string && d.categoryId.size() <= 64))
            && (!('memo' in d) || (d.memo is string && d.memo.size() <= 1000))
            && (!('date' in d) || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (!('hasReceipt' in d) || d.hasReceipt is bool)
            && (!('settledIds' in d) || (d.settledIds is list && d.settledIds.size() <= 100))
            && (!('deletedAt' in d) || d.deletedAt is int)
            && (!('trashedAt' in d) || d.trashedAt is timestamp);
        }

        allow read, delete: if true;
        allow create: if validExpense(request.resource.data) && tripExists(tripId);
        allow update: if validExpense(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
